# Copy this file to `.env` and adjust values. `.env` is never committed.

# --- PostgreSQL (used by compose.yaml) ---
POSTGRES_DB=eventos
POSTGRES_USER=eventos
POSTGRES_PASSWORD=eventos
POSTGRES_PORT=5432

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
# Generate a real one with: uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Must match the POSTGRES_* values above
DATABASE_URL=postgres://eventos:eventos@localhost:5432/eventos
