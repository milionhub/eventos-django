# Copy this file to `.env` and adjust values. `.env` is never committed.

# --- PostgreSQL (used by compose.yaml) ---
POSTGRES_DB=eventos
POSTGRES_USER=eventos
POSTGRES_PASSWORD=eventos
POSTGRES_PORT=5432

# --- Django ---
# Generate a real one with: uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# To test the scanner on a phone through a cloudflared tunnel (docs/guia-movil.md), append
# ",.trycloudflare.com": the Angular proxy keeps the tunnel's Host header.
# Must match the POSTGRES_* values above. Use 127.0.0.1, not localhost: on Windows
# "localhost" tries IPv6 (::1) first and hangs because the container listens on IPv4 only.
DATABASE_URL=postgres://eventos:eventos@127.0.0.1:5432/eventos

# --- Behind a reverse proxy (production) ---
# How many proxies in front of Django append to X-Forwarded-For (nginx: 1). It decides which
# IP the rate limits count; 0 (default) ignores the header, which any client can forge.
# NUM_PROXIES=1
